[Desktop Entry]
Type=Application
Version=1.0
Name=Rastery
GenericName=Image Toolbox
Comment=Lightweight local image processing toolbox
Exec=rastery %F
Icon=app.rastery.Rastery
Terminal=false
Categories=Graphics;Photography;
Keywords=image;crop;resize;convert;compress;collage;watermark;QR;EXIF;GIF;
MimeType=image/png;image/jpeg;image/webp;image/bmp;image/gif;
StartupNotify=true
StartupWMClass=app.rastery.Rastery
